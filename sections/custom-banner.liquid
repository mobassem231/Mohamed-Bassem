
{{ 'custom-banner.css' | asset_url | stylesheet_tag }}

<div class="custom-banner__top-bar">
  {% if section.settings.top_bar_logo_text != blank %}
    <p class="custom-banner__top-bar-logo">{{ section.settings.top_bar_logo_text }}</p>
  {% endif %}
  {% if section.settings.top_bar_text != blank %}
    <p class="custom-banner__top-bar-text">{{ section.settings.top_bar_text }}</p>
  {% endif %}
  {% if section.settings.top_bar_button_label != blank %}
    <a href="{{ section.settings.top_bar_button_url | default: '#' }}" class="custom-banner__top-bar-button">
      <span>{{ section.settings.top_bar_button_label }}</span>
      <span aria-hidden="true">→</span>
    </a>
  {% endif %}
</div>

<div class="custom-banner">
  <div class="custom-banner__illustration">
    {% if section.settings.illustration %}
      {{ section.settings.illustration | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Gift guide illustration', width: section.settings.illustration.width, height: section.settings.illustration.height }}
    {% endif %}
  </div>

  <div class="custom-banner__content">
    {% if section.settings.heading != blank %}
      <h1 class="custom-banner__heading">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="custom-banner__description">{{ section.settings.description }}</div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url | default: '#' }}" class="custom-banner__button">
        <span>{{ section.settings.button_label }}</span>
        <span class="custom-banner__button-arrow">→</span>
      </a>
    {% endif %}
  </div>

  {% if section.settings.footer_text != blank %}
    <div class="custom-banner__footer">
      {{ section.settings.footer_text }}
    </div>
  {% endif %}
</div>

{% schema %}

{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Illustration image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer strip text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
  "type": "text",
  "id": "top_bar_logo_text",
  "label": "Top bar logo text",
  "default": "TISSO VISON"
},
{
  "type": "text",
  "id": "top_bar_text",
  "label": "Top bar text",
  "default": "Find the ideal gift for your loved ones."
},
{
  "type": "text",
  "id": "top_bar_button_label",
  "label": "Top bar button label",
  "default": "CHOOSE GIFT"
},
{
  "type": "url",
  "id": "top_bar_button_url",
  "label": "Top bar button link"
}
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}